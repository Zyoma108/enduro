# Секреты задаются через переменные окружения (или локальный .env, он в .gitignore).
# Вложенные поля разделяются двойным подчёркиванием.
# ENDURO_MARKET__SYMBOLS='["BTC/USDT:USDT"]'

# Ключи Bybit. Для demo — ключи, выпущенные в режиме Demo Trading.
# Права: только Contracts → Orders & Positions, без вывода и переводов.
# ENDURO_BYBIT__API_KEY=
# ENDURO_BYBIT__API_SECRET=

# Ключ Anthropic API для агента.
# ENDURO_ANTHROPIC__API_KEY=
